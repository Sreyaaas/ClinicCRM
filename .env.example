# Supabase PostgreSQL connection string (keep standard public schema tables)
# Use Session Pooler (port 5432, works for both runtime + prisma db push over IPv4) or Transaction Pooler (port 6543 with ?pgbouncer=true)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Supabase project URL & API keys (Settings -> API Keys / Connect in Supabase)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_replace-with-real-supabase-key"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_replace-with-real-supabase-key"

# Auth session signing secret (generate a long random string, e.g. openssl rand -base64 32)
SESSION_SECRET="replace-with-a-32-char-random-secret-key"

# Storage routing: "local" for quick local dev, "b2" for Backblaze B2 (or S3-compatible R2)
ACTIVE_STORAGE_PROVIDER="local"

# Backblaze B2 S3-compatible credentials (no credit card required for 10 GB free tier)
B2_ENDPOINT="https://s3.eu-central-003.backblazeb2.com"
B2_REGION="eu-central-003"
B2_BUCKET="your-private-clinic-bucket"
B2_KEY_ID="your-b2-application-key-id"
B2_APP_KEY="your-b2-application-key"

# Optional demo login shortcuts & pilot plan switching on /login and /app/settings (set "false" in live production)
NEXT_PUBLIC_ENABLE_DEMO_USERS="true"

# Google Gemini API Key for Instant Prescription OCR & Medical Details Auto-Population
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"
# Optional model override (defaults to gemini-3.8-flash; can also use gemini-3.5-flash-lite)
GEMINI_MODEL="gemini-3.8-flash"
